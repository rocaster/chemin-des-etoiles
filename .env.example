# Placeholders only. Copy to .env locally and fill privately; never commit .env.
# Azure reference syntax is configured in App Service, not resolved by dotenv.
COSMOS_CONNECTION=REPLACE_WITH_LOCAL_COSMOS_CONNECTION_STRING
STORAGE_CONNECTION=REPLACE_WITH_LOCAL_STORAGE_CONNECTION_STRING
SECRET_KEY=REPLACE_WITH_STRONG_STABLE_RANDOM_SECRET
MAIL_SERVER=REPLACE_WITH_SMTP_HOST
MAIL_PORT=REPLACE_WITH_SMTP_PORT
MAIL_USE_TLS=REPLACE_WITH_TLS_BOOLEAN
MAIL_USERNAME=REPLACE_WITH_SMTP_LOGIN
MAIL_FROM=REPLACE_WITH_VERIFIED_SENDER
MAIL_PASSWORD=REPLACE_WITH_SMTP_KEY
APP_BASE_URL=REPLACE_WITH_LOCAL_BASE_URL
# Azure deployment only:
SCM_DO_BUILD_DURING_DEPLOYMENT=REPLACE_WITH_BUILD_BOOLEAN
# Explicitly empty disables the default special test-user list:
NCL_USUARIOS_TESTE=
NCL_SENHA_TESTE=REPLACE_IF_SPECIAL_TEST_USERS_ARE_ENABLED
NCL_MODO_TESTE=REPLACE_WITH_TEST_MODE_BOOLEAN
